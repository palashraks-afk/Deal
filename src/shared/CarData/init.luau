-- The 1000-car list. Rows live in Chunk1..4 (generated by tools/gen_cars.py).
-- Row layout: {id, rarity, brand, model, basedOn, body, length_m, width_m, height_m, hp, topKmh, value, income, paint}

local rows = {}
for i = 1, 4 do
	for _, row in require(script:WaitForChild("Chunk" .. i)) do
		table.insert(rows, row)
	end
end

local cars = table.create(#rows)
for _, r in rows do
	cars[r[1]] = {
		id = r[1],
		rarity = r[2],
		brand = r[3],
		model = r[4],
		name = r[3] .. " " .. r[4],
		basedOn = r[5], -- real car, reference only; never shown in game
		body = r[6],
		length = r[7],
		width = r[8],
		height = r[9],
		hp = r[10],
		topKmh = r[11],
		value = r[12],
		income = r[13],
		paint = r[14],
	}
end

return cars
